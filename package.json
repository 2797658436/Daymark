{
  "name": "daymark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "check": "npm run build && npm run test && npm run test:e2e && npm run test:native",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
